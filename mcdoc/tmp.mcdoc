/// 一時保存用のストレージ
dispatch minecraft:storage[gg_tmp:] to struct {
    /// プレイヤー設定を一時的に保存する
    player: super::settings::PlayerSettings,

    /// お墓を一時的に保存する
    grave: super::settings::Grave,

    /// お墓をすべて保存する
    graves: [super::settings::Grave],

    /// idを保存しておく
    id: struct {
        /// プレイヤーのid
        player: int,

        /// お墓のid
        grave: int
    },

    /// テキストの作業領域
    text: struct {
        A: any,
        B: any
    },

    /// アイテムidをテキストに変換するための作業領域
    idToText: any,

    /// チャンクをロードするときに情報を入れる箱
    chunkLoad: struct ChunkData {
        dimension: string,
        x: int,
        z: int,
        isAlreadyLoaded: byte
    },

    /// アイテムをドロップするときのやつ
    dropItems: struct {
        inventory: [struct {}],
        equipment: any,
        item: struct {},
        index: int
    },

    /// 名前を設定する
    setName: struct {
        x: int,
        y: int,
        z: int
    },

    /// テレポート時に使う箱
    teleport: struct Teleport {
        dimension: string,
        x: double,
        y: double,
        z: double
    },

    /// 場所がロードされているか確認する
    loaded: struct {
        pos: struct {
            x: int,
            y: int,
            z: int,
            dimension: string
        },
        isLoaded: boolean
    }
}