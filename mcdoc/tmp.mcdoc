/// 一時保存用のストレージ
dispatch minecraft:storage[gg_tmp:] to struct {
    /// プレイヤー設定を一時的に保存する
    player: ::settings::PlayerSettings,

    /// お墓を一時的に保存する
    grave: ::settings::Grave,

    /// お墓をすべて保存する
    graves: [::settings::Grave],

    /// idを保存しておく
    id: struct {
        /// プレイヤーのid
        player: int,

        /// お墓のid
        grave: int
    },

    /// テキストの作業領域
    text: struct {
        A: any,
        B: any
    },

    /// アイテムidをテキストに変換するための作業領域
    idToText: any,

    /// お墓を読み込むときに情報を入れる箱
    graveLoad: struct {
        dimension: string,
        x: int,
        z: int,
        isAlreadyLoaded: byte
    },

    /// アイテムをドロップするときのやつ
    dropItems: struct {
        inventory: [struct {}],
        equipment: any,
        item: struct {},
        index: int
    },

    /// 名前を設定する
    setName: struct {
        x: int,
        y: int,
        z: int
    }
}