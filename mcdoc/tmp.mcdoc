/// 一時保存用のストレージ
dispatch minecraft:storage[gg_tmp:] to struct {
    /// プレイヤー設定を一時的に保存する
    player: ::settings::PlayerSettings,

    /// お墓を一時的に保存する
    grave: ::settings::Grave,

    /// idを保存しておく
    id: struct {
        /// プレイヤーのid
        player: int,

        /// お墓のid
        grave: int
    },

    /// テキストの作業領域
    text: struct {
        A: any,
        B: any
    },

    /// アイテムidをテキストに変換するための作業領域
    idToText: any,

    /// お墓を読み込むときに情報を入れる箱
    graveLoad: struct {
        dimension: string,
        x: int,
        z: int
    },

    /// アイテムをドロップするときのやつ
    dropItems: struct {
        inventory: [struct {}],
        item: struct {},
        index: int
    },

    /// ワールドの設定を保存(文字列)
    worldSettings: struct {
        /// 経験値を保持する
        keepExpT: string,
        keepExpF: string,

        /// クイック取得
        quickGetT: string,
        quickGetF: string,
        
        /// ワンクリックでお墓を破壊する
        oneClickT: string,
        oneClickF: string,

        /// 憑依機能
        posessionT: string,
        posessionF: string,

        /// お墓へのテレポート
        tpGraveT: string,
        tpGraveF: string,

        /// 一人当たりのお墓の保存上限
        graveMax: int,

        /// キープインベントリ
        keepInventoryT: string,
        keepInventoryF: string,

        /// マクロを入れる
        text: string
    },

    /// スコアを文字列に変換
    scoreToString: struct {
        /// スコア
        score: int,

        /// 文字
        result: string
    }
}