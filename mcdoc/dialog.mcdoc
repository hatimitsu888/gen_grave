dispatch minecraft:storage[gg_common:dialog] to struct {
    /// バージョン
    version: string,

    /// ワールドの設定を保存(文字列)
    worldSettings: struct {
        /// バージョン
        version: string,

        /// 経験値を保持する
        keepExpT: string,
        keepExpF: string,

        /// クイック取得
        quickGetT: string,
        quickGetF: string,
        
        /// ワンクリックでお墓を破壊する
        oneClickT: string,
        oneClickF: string,

        /// お墓へのテレポート
        tpGraveT: string,
        tpGraveF: string,

        /// 一人当たりのお墓の保存上限
        graveMax: int,

        /// キープインベントリ
        keepInventoryT: string,
        keepInventoryF: string,

        /// マクロを入れる
        text: string
    },

    /// プレイヤー設定を保存(文字列)
    playerSettings: struct {
        /// 他の人が壊せるかどうか
        othersBreakingT: string,
        othersBreakingF: string,

        /// 経験値
        exp: string,

        /// アイテム
        items: string,

        /// マクロを入れる
        text: string
    },

    /// お墓
    graves: struct {
        /// 並べ替え
        new: string,
        old: string,

        /// 個数
        count: int,

        /// アクション
        actions: [struct {
            label: struct {
                text: string
            }
        }],
    },

    /// スコアを文字列に変換
    scoreToString: struct {
        /// スコア
        score: int,

        /// 文字
        result: string
    },

    /// 一覧に記載する情報
    label: struct {
        triggerA: int,
        triggerB: int,
        name: string,
        dimension: string
    },

    /// 詳細に記載する情報
    detail: struct {
        name: string,
        dimension: string,
        x: int,
        y: int,
        z: int,
        xpL: int,
        xpP: int,
        id: string
    },

    /// 削除ページに記載する情報
    delete: struct {
        name: string,
        id: string
    }
}