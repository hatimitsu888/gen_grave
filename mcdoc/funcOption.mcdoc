/// 関数を実行するときのオプション
dispatch minecraft:storage[gg_common:func_option] to struct {
    /// プレイヤー設定の初期化
    playerSettings: struct {
        /// idを初期化する
        resetId: boolean,

        /// プレイヤーの情報を消去する,
        deletePlayerData: boolean,

        /// お墓を初期化する
        resetGraves: boolean,

        /// idを一時保存しておく
        tmpId: int
    }
}
